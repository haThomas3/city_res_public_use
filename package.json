{
  "name": "portfolio-city",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A portfolio as an interactive 3D city: every building is a project",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
